# Copy to .env.local for local/dev. For GitHub Pages, set the same names
# as repository Actions secrets / Vite env vars at build time.
#
# Use the publishable / anon key here — NEVER the secret / service_role key.
# Baseline AB is uploaded with the anon key (insert-only RLS).
# Website never gets a download URL; fetch baseline with service role / Dashboard.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Review page (Mapbox map + optional Mapillary street views)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token
VITE_MAPILLARY_TOKEN=MLY|your_mapillary_token
